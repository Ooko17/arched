      <aliases enabled='yes' />
      <column caption='Android Ver' datatype='string' name='[Android_Ver]' role='dimension' type='nominal' />
      <column caption='Installs Per App' datatype='real' name='[Calculation_0760104467759104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Installs_Num]) / COUNT([App])' />
      </column>
      <column caption='Price Band' datatype='string' name='[Calculation_0760104467890177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price_USD]=0 THEN &quot;Free&quot;&#13;&#10;ELSEIF [Price_USD]&lt;=1 THEN &quot;&lt;=$1&quot;&#13;&#10;ELSEIF [Price_USD]&lt;=3 THEN &quot;$1-3&quot;&#13;&#10;ELSEIF [Price_USD]&lt;=5 THEN &quot;$3-5&quot;&#13;&#10;ELSEIF [Price_USD]&lt;=10 THEN &quot;$5-10&quot;&#13;&#10;ELSE &quot;&gt;$10&quot; END' />
      </column>
      <column caption='Size Band' datatype='string' name='[Calculation_0760104468078594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Size_MB]) THEN &quot;Varies&quot;&#13;&#10;ELSEIF [Size_MB]&lt;=5 THEN &quot;&lt;5&quot;&#13;&#10;ELSEIF [Size_MB]&lt;=15 THEN &quot;5-15&quot;&#13;&#10;ELSEIF [Size_MB]&lt;=30 THEN &quot;15-30&quot;&#13;&#10;ELSEIF [Size_MB]&lt;=60 THEN &quot;30-60&quot;&#13;&#10;ELSE &quot;60+&quot; END' />
      </column>
      <column caption='Apps In Category' datatype='integer' name='[Calculation_0760104468201475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Category] : COUNT([App])}' />
      </column>
      <column caption='Meets min' datatype='boolean' name='[Calculation_0760104474058759]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0760104468201475] &gt;= [Parameters].[Parameter 0760104473509893]' />
